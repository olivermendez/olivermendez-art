---
import { t, casePaths, type Lang } from '../i18n';
import { links, mailto } from '../data/links';
import { projects, caseIds } from '../data/projects';
import Browser from './Browser.astro';
import Button from './Button.astro';
import TextLink from './TextLink.astro';
import Pending from './Pending.astro';
import Spec from './Spec.astro';
import Shot from './Shot.astro';
import Tools from './Tools.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const T = t(lang);
const C = T.cases;
const P = projects;
const caseUrl = (id: keyof typeof projects) => casePaths(id)[lang];
const { autolisto, mesapos, scanova, premium } = C;
const clients = caseIds.map((id) => C[id].name);
---

<!-- Hero -->
<section class="band hero">
  <div class="wrap hero__inner">
    <div class="hero__text">
      <p class="eyebrow hero__status" data-reveal>
        <span class="hero__dot" aria-hidden="true"></span>
        <span class="hero__status-long">{T.hero.status}</span>
        <span class="hero__status-short">{T.hero.statusShort}</span>
      </p>
      <h1 class="display hero__title" data-reveal style="--i:1">
        {T.hero.line1}
        {' '}{T.hero.line2} <em>{T.hero.em}</em>
      </h1>
      <div class="hero__lead-row" data-reveal style="--i:2">
        <p class="hero__lead">{T.hero.lead}</p>
        <div class="hero__actions">
          <Button href="#proyectos">{T.hero.ctaProjects}</Button>
        </div>
      </div>
    </div>

    <div class="hero__profiles" data-reveal style="--i:3">
      <TextLink href={links.linkedin} arrow="↗">LinkedIn</TextLink>
      <TextLink href={links.github} arrow="↗">GitHub</TextLink>
      <TextLink href="#contacto" arrow="→">{T.hero.contact}</TextLink>
    </div>

    <Browser url={T.demo.url} class="hero__demo" data-reveal>
      <Shot {...P.autolisto.built[0]!} alt={T.demo.alt} eager />
    </Browser>

    <ul class="hero__clients" data-reveal>
      {clients.map((c) => <li>{c}</li>)}
    </ul>
  </div>
</section>

<!-- Trabajo seleccionado -->
<section class="band work" id="proyectos">
  <div class="wrap work__inner">
    <header class="sec-head" data-reveal>
      <p class="eyebrow">{T.work.eyebrow}</p>
      <h2 class="h2">{T.work.title}</h2>
    </header>

    <!-- Nº 01 AutoListo -->
    <article class="proj" data-reveal>
      <div class="proj__text">
        <p class="eyebrow">{autolisto.no}</p>
        <div class="proj__title">
          <h3 class="display proj__name">{autolisto.name}</h3>
          <p class="proj__desc">{autolisto.desc}</p>
        </div>
        <Spec lang={lang} spec={autolisto.spec} />
        <div class="proj__links">
          <TextLink href={caseUrl('autolisto')} arrow="→">{T.work.seeCase}</TextLink>
          <TextLink href={P.autolisto.url} arrow="↗">{T.work.visit}</TextLink>
        </div>
      </div>
      <div class="proj__visual proj__visual--duo">
        <Browser url={T.demo.fichaUrl} class="duo__browser">
          <Shot {...P.autolisto.card} alt={`${autolisto.name} — ${autolisto.built[1].title}`} />
        </Browser>
        <div class="phone duo__phone">
          <div class="phone__screen"><Shot {...P.autolisto.phone} alt={`${autolisto.name} — ${autolisto.built[3].title}`} /></div>
        </div>
      </div>
    </article>

    <!-- Nº 02 MesaPOS -->
    <article class="proj proj--flip" id="mesapos" data-reveal>
      <div class="proj__visual">
        <Browser url={P.mesapos.site} class="proj__browser">
          <Shot {...P.mesapos.card} alt={`${mesapos.name} — ${P.mesapos.site}`} />
        </Browser>
      </div>
      <div class="proj__text">
        <p class="eyebrow">{mesapos.no}</p>
        <div class="proj__title">
          <h3 class="display proj__name">{mesapos.name}</h3>
          <p class="proj__desc">{mesapos.desc}</p>
        </div>
        <Spec lang={lang} spec={mesapos.spec} />
        <div class="proj__links">
          <TextLink href={caseUrl('mesapos')} arrow="→">{T.work.seeCase}</TextLink>
          <TextLink href={P.mesapos.url} arrow="↗">{T.work.visit}</TextLink>
        </div>
      </div>
    </article>

    <!-- Nº 03 Scanova -->
    <article class="proj" id="scanova" data-reveal>
      <div class="proj__text">
        <p class="eyebrow">{scanova.no}</p>
        <div class="proj__title">
          <h3 class="display proj__name">{scanova.name}</h3>
          <p class="proj__desc">{scanova.desc}</p>
        </div>
        <Spec lang={lang} spec={scanova.spec} />
        <div class="proj__links">
          <TextLink href={caseUrl('scanova')} arrow="→">{T.work.seeCase}</TextLink>
        </div>
      </div>
      <div class="proj__visual">
        <Browser url={`${scanova.name} — ${scanova.kind}`} class="proj__browser">
          <Shot {...P.scanova.card} alt={`${scanova.name} — ${scanova.built[1].title}`} />
        </Browser>
      </div>
    </article>

    <!-- Nº 04 Premium Diagnósticos -->
    <article class="proj proj--flip" data-reveal>
      <div class="proj__visual">
        <Browser url={P.premium.site} class="proj__browser">
          <Shot {...P.premium.card} alt={`${premium.name} — ${P.premium.site}`} />
        </Browser>
      </div>
      <div class="proj__text">
        <p class="eyebrow">{premium.no}</p>
        <div class="proj__title">
          <h3 class="display proj__name">{premium.name}</h3>
          <p class="proj__desc">{premium.desc}</p>
        </div>
        <Spec lang={lang} spec={premium.spec} />
        <div class="proj__links">
          <TextLink href={caseUrl('premium')} arrow="→">{T.work.seeCase}</TextLink>
          <TextLink href={P.premium.url} arrow="↗">{T.work.visit}</TextLink>
        </div>
      </div>
    </article>
  </div>
</section>

<!-- Más trabajos -->
<section class="band more">
  <div class="wrap more__inner">
    <header class="sec-head" data-reveal>
      <p class="eyebrow">{T.more.eyebrow}</p>
      <h2 class="h2">{T.more.title}</h2>
    </header>
    <div class="more__grid">
      {
        (['caceres', 'cacebal', 'medwork'] as const).map((id, i) => (
          <a class="more__card card-hover" href={caseUrl(id)} data-reveal style={`--i:${i}`}>
            <Browser url={P[id].site} class="more__browser">
              <Shot {...P[id].card} alt={`${C[id].name} — ${P[id].site}`} />
            </Browser>
            <div class="more__info">
              <div class="more__head">
                <h3 class="display more__name">{C[id].name}</h3>
                <span class="eyebrow more__tag">{C[id].kind}</span>
              </div>
              <p class="muted">{C[id].desc}</p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<!-- Experiencia -->
<section class="band band--surface exp" id="experiencia">
  <div class="wrap exp__inner">
    <div class="exp__head" data-reveal>
      <p class="eyebrow eyebrow--accent">{T.experience.eyebrow}</p>
      <h2 class="h2">{T.experience.title}</h2>
    </div>
    <div class="exp__list">
      {
        T.experience.rows.map((row, i) => (
          <article class="exp__row" data-reveal style={`--i:${i}`}>
            <div class="exp__role">
              <p class="eyebrow eyebrow--accent">{row.period}</p>
              <h3 class="exp__name">{row.name}</h3>
              <p class="muted">{row.role}</p>
              <p class="eyebrow eyebrow--accent">{row.status}</p>
            </div>
            <div class="exp__body">
              <p class="exp__lead">{row.lead}</p>
              {row.ps.map((p) => <p class="muted">{p}</p>)}
              {row.case && (
                <div><TextLink href={caseUrl(row.case as keyof typeof projects)} arrow="→">{T.experience.link}</TextLink></div>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- Sobre mí -->
<section class="band band--line about" id="sobre-mi">
  <div class="wrap about__inner">
    <figure class="about__portrait" data-reveal>
      <img src="/img/oliver-mendez.jpg" alt={T.about.portraitAlt} width="920" height="1226" loading="lazy" decoding="async" />
    </figure>
    <div class="about__text" data-reveal style="--i:1">
      <p class="eyebrow">{T.about.eyebrow}</p>
      <h2 class="h2">{T.about.title}</h2>
      <p class="about__p">{T.about.p1}</p>
      <p class="about__p muted">{T.about.p2}</p>
      <p class="about__p muted">{T.about.p3}</p>
    </div>
  </div>
</section>

<!-- Tecnologías y herramientas -->
<Tools lang={lang} />

<!-- Cómo trabajo -->
<section class="band process">
  <div class="wrap process__inner">
    <header class="sec-head" data-reveal>
      <p class="eyebrow">{T.process.eyebrow}</p>
      <h2 class="h2">{T.process.title}</h2>
    </header>
    <ol class="process__steps">
      {
        T.process.steps.map(([title, desc], i) => (
          <li class="step" data-reveal style={`--i:${i}`}>
            <span class="step__line" aria-hidden="true">
              <i class:list={['step__dot', { 'step__dot--last': i === T.process.steps.length - 1 }]} />
            </span>
            <div class="step__text">
              <span class="eyebrow">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="display step__title">{title}</h3>
              <p class="muted">{desc}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<!-- Servicios -->
<section class="band band--surface services">
  <div class="wrap services__inner">
    <header class="sec-head" data-reveal>
      <p class="eyebrow">{T.services.eyebrow}</p>
      <h2 class="h2">{T.services.title}</h2>
    </header>
    <div class="services__cols">
      {
        T.services.items.map((s, i) => (
          <article class="service" data-reveal style={`--i:${i}`}>
            <span class="eyebrow service__no">Nº {String(i + 1).padStart(2, '0')}</span>
            <h3 class="display service__title">{s.title}</h3>
            <p class="muted">{s.desc}</p>
            <p class="service__ex">{s.ex}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- Contacto -->
<section class="band band--surface contact" id="contacto">
  <div class="wrap contact__inner">
    <header class="contact__head" data-reveal>
      <p class="eyebrow">{T.contact.eyebrow}</p>
      <h2 class="display contact__title">{T.contact.title}</h2>
    </header>
    <div class="contact__cards">
      <article class="ccard" data-reveal>
        <div class="ccard__text">
          <p class="eyebrow">{T.contact.hire.eyebrow}</p>
          <h3 class="display ccard__title">{T.contact.hire.title}</h3>
          <p class="muted">{T.contact.hire.desc}</p>
        </div>
        <div class="ccard__actions">
          <TextLink href={links.linkedin} arrow="↗">LinkedIn</TextLink>
          <TextLink href={links.github} arrow="↗">GitHub</TextLink>
        </div>
        {
          (!links.linkedin || !links.github) && (
            <div class="ccard__pending">
              {!links.linkedin && <Pending lang={lang} label="LinkedIn" />}
              {!links.github && <Pending lang={lang} label="GitHub" />}
            </div>
          )
        }
      </article>
      <article class="ccard" data-reveal style="--i:1">
        <div class="ccard__text">
          <p class="eyebrow">{T.contact.project.eyebrow}</p>
          <h3 class="display ccard__title">{T.contact.project.title}</h3>
          <p class="muted">{T.contact.project.desc}</p>
        </div>
        <div class="ccard__actions">
          <Button href={mailto(links.email)}>{T.contact.project.email}</Button>
          {links.whatsapp && <Button href={links.whatsapp} variant="secondary" external>{T.contact.project.whatsapp}</Button>}
        </div>
      </article>
    </div>
    <p class="contact__email" data-reveal>
      <span class="eyebrow">{T.contact.emailLabel}</span>
      {
        links.email ? (
          <TextLink href={mailto(links.email)}>{links.email}</TextLink>
        ) : (
          <Pending lang={lang} label={T.contact.pendingEmail} />
        )
      }
    </p>
  </div>
</section>

<style>
  /* Hero */
  .hero__inner {
    display: flex;
    flex-direction: column;
    gap: 56px;
    padding-block: 112px 72px;
  }
  .hero__text {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .hero__status {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .hero__status-short {
    display: none;
  }
  .hero__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }
  .hero__title {
    max-width: 960px;
    font-size: clamp(48px, 6.67vw, 96px);
    line-height: 1.02;
    letter-spacing: -0.016em;
    text-wrap: balance;
  }
  .hero__title em {
    font-style: italic;
    margin-left: 0.12em;
  }
  .hero__lead-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
  }
  .hero__lead {
    max-width: 560px;
    font-size: 18px;
    line-height: 1.55;
    color: var(--ink-muted);
  }
  .hero__actions {
    display: flex;
    gap: 12px;
    flex-shrink: 0;
  }
  .hero__profiles {
    display: flex;
    gap: 28px;
  }
  :global(.hero__demo) {
    height: 640px;
  }
  .hero__clients {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  /* Trabajo seleccionado */
  .work__inner {
    display: flex;
    flex-direction: column;
    gap: 96px;
    padding-block: 120px;
  }
  .proj {
    display: grid;
    grid-template-columns: 440px 1fr;
    gap: 80px;
    align-items: center;
  }
  .proj--flip {
    grid-template-columns: 1fr 440px;
  }
  .proj__text {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .proj__title {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .proj__name {
    font-size: clamp(34px, 3.9vw, 56px);
    line-height: 1.05;
  }
  .proj__desc {
    font-size: 18px;
    line-height: 1.5;
  }
  .proj__links {
    display: flex;
    gap: 28px;
  }
  .proj__visual {
    min-width: 0;
  }
  :global(.proj__browser) {
    height: 440px;
  }
  .proj__visual--duo {
    position: relative;
    height: 540px;
  }
  :global(.duo__browser) {
    position: absolute;
    top: 40px;
    left: 0;
    width: calc(100% - 80px);
    height: 400px;
  }
  :global(.duo__phone) {
    position: absolute;
    top: 110px;
    right: 0;
    width: 200px;
    height: 416px;
  }

  /* Más trabajos */
  .more__inner {
    display: flex;
    flex-direction: column;
    gap: 56px;
    padding-bottom: 120px;
  }
  .more__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .more__card {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  :global(.more__browser) {
    height: 380px;
  }
  .more__info {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .more__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }
  .more__name {
    font-size: 32px;
    line-height: 1.3;
  }
  .more__tag {
    font-size: 12px;
  }

  /* Experiencia */
  .exp__inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-block: 80px;
  }
  .exp__head {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .exp__list {
    border-bottom: 1px solid var(--line);
  }
  .exp__row {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 64px;
    padding-block: 28px;
    border-top: 1px solid var(--line);
    line-height: 1.55;
  }
  .exp__role {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .exp__name {
    font-size: 24px;
    font-weight: 400;
  }
  .exp__body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .exp__lead {
    font-size: 20px;
  }

  /* Sobre mí */
  .about__inner {
    display: grid;
    grid-template-columns: 460px 1fr;
    gap: 96px;
    align-items: center;
    padding-block: 120px;
  }
  .about__portrait {
    display: grid;
    place-items: center;
    aspect-ratio: 460 / 560;
    margin: 0;
    overflow: hidden;
    border-radius: 8px;
    background: var(--line);
  }
  .about__portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
  }
  .about__text {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .about__p {
    font-size: 20px;
    line-height: 1.55;
  }

  /* Cómo trabajo */
  .process .sec-head,
  .services .sec-head {
    border-bottom: 0;
  }
  .process__inner {
    display: flex;
    flex-direction: column;
    gap: 36px;
    padding-block: 72px;
  }
  .process__steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .step {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .step__line {
    display: flex;
    align-items: center;
    height: 9px;
  }
  .step__line::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line);
  }
  .step:last-child .step__line::after {
    display: none;
  }
  .step__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--ink);
    flex-shrink: 0;
  }
  .step__dot--last {
    background: var(--accent);
  }
  .step__text {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-right: 32px;
    line-height: 1.55;
  }
  .step__title {
    font-size: 28px;
    line-height: 1.1;
  }

  /* Servicios */
  .services__inner {
    display: flex;
    flex-direction: column;
    gap: 36px;
    padding-block: 72px;
  }
  .services__cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
  }
  .service {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--ink);
    line-height: 1.55;
  }
  .service__no {
    color: var(--ink);
  }
  .service__title {
    font-size: 32px;
    line-height: 1.1;
  }
  .service__ex {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    line-height: 1.6;
    color: var(--ink-muted);
  }

  /* Contacto */
  .contact__inner {
    display: flex;
    flex-direction: column;
    gap: 56px;
    padding-block: 120px 96px;
  }
  .contact__head {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .contact__title {
    font-size: clamp(46px, 6.67vw, 96px);
    line-height: 1;
    letter-spacing: -0.016em;
  }
  .contact__cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .ccard {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 40px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 10px;
  }
  .ccard__text {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .ccard__title {
    font-size: clamp(28px, 2.8vw, 40px);
    line-height: 1.1;
  }
  .ccard__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .ccard__actions :global(.tlink) {
    margin-left: 4px;
  }
  .ccard__pending {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .contact__email {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 1180px) {
    .proj,
    .proj--flip {
      grid-template-columns: 380px 1fr;
      gap: 48px;
    }
    .proj--flip {
      grid-template-columns: 1fr 380px;
    }
    .about__inner {
      grid-template-columns: 380px 1fr;
      gap: 64px;
    }
  }

  @media (max-width: 900px) {
    .hero__inner {
      gap: 28px;
      padding-block: 48px 40px;
    }
    .hero__text {
      gap: 20px;
    }
    .hero__status {
      font-size: 11px;
      gap: 8px;
    }
    .hero__status-long {
      display: none;
    }
    .hero__status-short {
      display: inline;
    }
    .hero__lead-row {
      flex-direction: column;
      align-items: stretch;
      gap: 24px;
    }
    .hero__lead {
      font-size: 16px;
    }
    .hero__actions {
      flex-direction: column;
      gap: 10px;
    }
    .hero__actions :global(.btn) {
      width: 100%;
    }
    .hero__profiles {
